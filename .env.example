# Destination address for contact form + quiz submissions (see api/contact.js).
CONTACT_FORM_TO_EMAIL=mitzi@miabookkeeping.com

# SMTP credentials used to send the notification email. Any SMTP-capable
# inbox works (Gmail, Google Workspace, Outlook/Office 365, a hosting
# provider's mailbox, etc.) — these are NOT the same as CONTACT_FORM_TO_EMAIL
# above; this is the account that authenticates and sends the email, which
# can be the same address or a different one.
#
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_USER=your full email address, SMTP_PASS=a 16-char
# App Password (Google Account -> Security -> 2-Step Verification -> App
# Passwords — requires 2FA enabled; a regular account password will not work).
#
# Outlook / Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587,
# SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
